# npm Registry Configuration
# This file explicitly configures npm to use the default public registry

# Default npm registry
registry=https://registry.npmjs.org/

# Use strict SSL for security
strict-ssl=true

# Set cache location (optional - improves performance)
cache=~/.npm

# Logging level (can be: silent, error, warn, notice, http, timing, info, verbose, silly)
loglevel=notice

# Save exact versions in package.json (recommended for production)
save-exact=false

# Automatically save dependencies when installing
save=true

# Use package-lock.json for deterministic installs
package-lock=true

# Timeout for network requests (in milliseconds)
fetch-timeout=60000

# Retry settings for failed requests
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000