# Application Configuration
APP_NAME=Contract Intelligence System
DEBUG=False
API_VERSION=v1

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Provider Selection (ibm or gcp)
# You can mix and match (e.g., DB_PROVIDER=ibm, LLM_PROVIDER=gcp)
DB_PROVIDER=gcp
LLM_PROVIDER=gcp

# Google Cloud Platform (Firestore & Gemini)
GCP_PROJECT_ID=gen-lang-client-0100624913
FIRESTORE_DB_NAME=(default)
GEMINI_MODEL_ID=gemini-3-flash-preview

# If using Google AI Studio Free Tier (instead of Vertex AI), provide this key:
GOOGLE_API_KEY=AIzaSyDfykTOclX5aEESBBsnTGNRawsSaNW6cQQ

GOOGLE_APPLICATION_CREDENTIALS=gcp-key.json

# IBM Cloudant Database
CLOUDANT_URL=https://your-account.cloudantnosqldb.appdomain.cloud
CLOUDANT_API_KEY=your-cloudant-api-key
CLOUDANT_DB_NAME=contract-intelligence

# IBM watsonx.ai
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# Watson Discovery
DISCOVERY_API_KEY=your-discovery-api-key
DISCOVERY_URL=your-discovery-url
DISCOVERY_VERSION=2023-03-31
DISCOVERY_COLLECTION_ID=your-collection-id

# GitHub Integration
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-repository-name

# Microsoft Graph API (Outlook Calendar)
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=your-azure-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/callback

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=your-slack-channel-id

# IBM Cloud Object Storage
COS_API_KEY=your-cos-api-key
COS_INSTANCE_ID=your-cos-instance-id
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_BUCKET_NAME=contract-files

# IBM Event Streams (Kafka)
KAFKA_BROKERS=broker-1:9093,broker-2:9093
KAFKA_API_KEY=your-kafka-api-key
KAFKA_TOPIC_COMPLIANCE=compliance-metrics
KAFKA_TOPIC_ALERTS=alerts

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production-use-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.pdf,.docx,.doc

# Agent Configuration
CONTRACT_AGENT_ENABLED=true
COMPLIANCE_AGENT_ENABLED=true
RISK_AGENT_ENABLED=true
ALERT_AGENT_ENABLED=true
FORECAST_AGENT_ENABLED=true

# Monitoring Intervals (seconds)
COMPLIANCE_CHECK_INTERVAL=300
RISK_ASSESSMENT_INTERVAL=3600

# Alert Thresholds (0.0 to 1.0)
ALERT_CRITICAL_THRESHOLD=0.95
ALERT_HIGH_THRESHOLD=0.85
ALERT_MEDIUM_THRESHOLD=0.75

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s